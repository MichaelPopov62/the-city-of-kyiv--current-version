# --- Клиент (Vite, только переменные с префиксом VITE_) ---
# Локально: по умолчанию прокси Vite (см. .env.development). Прямой URL — только если нужен:
# VITE_API_URL=http://localhost:9000

# GitHub Actions: Settings → Secrets and variables → Actions → Secrets
# New repository secret: имя VITE_API_URL, значение https://... (без слеша в конце)

# --- Сервер (server/.env, не коммитить) ---
# TELEGRAM_TOKEN=
# TELEGRAM_CHAT_ID=
# CORS_ORIGIN=http://localhost:5173,https://ВАШ_ЛОГИН.github.io
